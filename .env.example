# Copy this file to ".env" and set actual values.

# Kabu API credentials
KABUS_API_PASSWD=change_me
KABUS_TRD_PASSWD=change_me

# LINE Messaging API（screening_notify / analyze --notify）
LINE_CHANNEL_ACCESS_TOKEN=change_me
# 送信先ユーザー ID（カンマ区切り）。2件登録すると1スロットあたり2通届く（3スロット→6通/日）
LINE_USER_IDS=Uxxxxxxxx

# Gemini API（シグナル銘柄の ★1-5 評価・任意）
GEMINI_API_KEY=change_me
# GEMINI_MODEL=gemini-3.6-flash

# GitHub Pages（LINE 通知の Web URL）
KABURADAR_PAGES_URL=https://lalakuma.github.io/KabuRadar3

# publish --push の push 先ブランチ（空なら origin/HEAD または現在ブランチを自動検出）
# KABURADAR_GIT_BRANCH=master
